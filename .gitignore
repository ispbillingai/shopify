# Secrets — parameters.php holds the DB credentials the installer generated.
# This repo is public. Never commit these.
/app/config/parameters.php
/app/config/parameters.yml
/config/settings.inc.php

# Generated at runtime
/var/cache/*
/var/logs/*
/var/sessions/*
/cache/*
!/var/cache/.gitkeep
!/var/logs/.gitkeep

# Merchant/customer data written by the running shop
/download/*
/upload/*
/img/tmp/*
/img/p/*
/img/c/*
/img/m/*
/img/su/*
/img/st/*

# Generated theme assets
/themes/*/assets/cache/*
/modules/*/config*.xml

# Written by PrestaShop itself at runtime, or when a language is installed.
# These are regenerated on demand, differ per environment, and would otherwise
# leave `git status` permanently dirty on the server and fight every pull.
/.htaccess
/robots.txt
# PrestaShop drops a protective .htaccess into module vendor dirs
/modules/*/vendor/.htaccess
/config/themes/
/var/modules/
/admin*/bundles/

# Translation catalogues + downloaded language packs (regenerated per language)
/translations/*/
/translations/*.zip

# Per-language mail templates. The shipped themes and partials stay tracked.
/mails/*/
!/mails/themes/
!/mails/_partials/

# Generated placeholder/flag imagery
/img/l/
/img/os/
/img/genders/

# HTMLPurifier writes its serializer cache inside vendor
/vendor/ezyang/htmlpurifier/library/HTMLPurifier/DefinitionCache/Serializer/

# Local
.idea/
.vscode/
*.log

# PrestaShop deletes these directory guards from module src/ dirs on its
# own (they interfere with entity autoloading). Tracking them means a dirty
# tree after every deploy. Directory listing is already off in the vhost.
/modules/*/src/**/index.php
